  "orchestration": {
    "name": "Manager brief delivery",
    "initialStageKey": "ready",
    "stages": [
      {
        "key": "ready",
        "name": "Ready",
        "stageType": "Queue",
        "columnKey": "ready",
        "instructions": "Wait for sprint and activated delivery-plan authorization.",
        "inputSchemaJson": "{\"type\":\"object\"}",
        "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 3600,
        "retryPolicy": {
          "maximumDelaySeconds": 300,
          "maximumAttempts": 3,
          "initialDelaySeconds": 30
        }
      },
      {
        "key": "development",
        "name": "Implementation",
        "stageType": "AgentExecution",
        "columnKey": "in-progress",
        "instructions": "Implement on the assigned story base and return code-published (game) or completed (software). Artifact delivery returns completed (game) or artifact-delivered (software) with artifactId, revisionId and sha256. Fix integrated work through a fresh reviewed change based on current story state.",
        "inputSchemaJson": "{\"type\":\"object\"}",
        "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 3600,
        "retryPolicy": {
          "maximumDelaySeconds": 300,
          "maximumAttempts": 3,
          "initialDelaySeconds": 30
        }
      },
      {
        "key": "technical-review",
        "name": "Technical Review",
        "stageType": "AgentExecution",
        "columnKey": "technical-review",
        "instructions": "Independently review the exact published source and current story target. Approval authorizes trusted task integration. Return commit and target-commit evidence.",
        "inputSchemaJson": "{\"type\":\"object\"}",
        "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 3600,
        "retryPolicy": {
          "maximumDelaySeconds": 300,
          "maximumAttempts": 3,
          "initialDelaySeconds": 30
        }
      },
      {
        "key": "task-integration",
        "name": "Task integration",
        "stageType": "TrustedPlatformAction",
        "columnKey": "technical-review",
        "instructions": "Trusted task integration into its story; independent QA must follow.",
        "inputSchemaJson": "{\"type\":\"object\"}",
        "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 3600,
        "retryPolicy": {
          "maximumDelaySeconds": 300,
          "maximumAttempts": 3,
          "initialDelaySeconds": 30
        },
        "platformAction": "source-control.task.integrate.v1"
      },
      {
        "key": "quality",
        "name": "Independent QA",
        "stageType": "AgentExecution",
        "columnKey": "quality",
        "instructions": "QA every exact delivery. Test the integrated story commit for code, or read the exact artifact revision for documents. Return passed or changes_requested with criterion evidence. No skip-QA route.",
        "inputSchemaJson": "{\"type\":\"object\"}",
        "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 3600,
        "retryPolicy": {
          "maximumDelaySeconds": 300,
          "maximumAttempts": 3,
          "initialDelaySeconds": 30
        }
      },
      {
        "key": "done",
        "name": "Done",
        "stageType": "Terminal",
        "columnKey": "done",
        "instructions": "Task QA passed; parent regression and acceptance continue independently.",
        "inputSchemaJson": "{\"type\":\"object\"}",
        "outputSchemaJson": "{\"type\":\"object\"}",
        "timeoutSeconds": 3600,
        "retryPolicy": {
          "maximumDelaySeconds": 300,
          "maximumAttempts": 3,
          "initialDelaySeconds": 30
        },
        "isSuccessfulTerminal": true
      }
    ],
